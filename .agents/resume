#!/usr/bin/env bash
set -euo pipefail

# Docker images and build layers persist; the daemon must start after activation.
sudo systemctl start docker
sudo chgrp "$(id -gn)" /var/run/docker.sock
docker info > /dev/null

# Setup prepares a reusable snapshot, not the current orb's live data.
if [[ "${1:-}" != --setup ]]; then
    "$(dirname "${BASH_SOURCE[0]}")/refresh-data"
fi
