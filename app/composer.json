{
    "name": "kevinsmith/cfbmarblegame",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-pdo": "*",
        "filp/whoops": "^2.16",
        "guzzlehttp/guzzle": "^7.10",
        "monolog/monolog": "^3.8",
        "nikic/fast-route": "^1.3",
        "php-di/php-di": "^7.0",
        "psr/container": "^2.0",
        "robmorgan/phinx": "^0.16.10",
        "sapien/sapien": "^1.1",
        "symfony/console": "^7.3"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "require-dev": {
        "doctrine/coding-standard": "^14.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5",
        "symfony/var-dumper": "^7.3"
    },
    "scripts": {
        "phinx": "vendor/bin/phinx --configuration=./config/phinx/phinx.php"
    }
}
